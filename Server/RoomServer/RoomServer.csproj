<Project Sdk="Microsoft.NET.Sdk">  <!--
    RoomServer（《状态同步实施方案》§4.5：.NET 8 控制台，单进程多房间，权威 Sim——MVP 不拆 Gate/Sim）。
    协议单源红线（§4.6）：直接引用 LiteNet 工程（其中 Protocol/ 纯函数与 Transport/ 分层），
    服务器侧另写消息结构在物理上不可能。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Luban Runtime 的 ByteBuf 用 unsafe 代码块（嵌入式包源链接进来要开这个） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    共享库按 NuGet 包消费，不再跨目录 ProjectReference 进 Assets/：
    包由 python scripts/build/pack-shared.py 产出到 LocalPackages/（不入库）。
    版本写**精确字面量**（L0 依赖扫描禁属性/浮动版本），与 SharedPackages.props 的单源一致性
    由 SharedPackageVersionPinTests 守卫。
  -->
  <ItemGroup>
    <PackageReference Include="LiteGame.Sim" Version="0.1.0" />
    <PackageReference Include="LiteGame.Net" Version="0.1.0" />
    <PackageReference Include="LiteGame.Sync" Version="0.1.0" />
    <PackageReference Include="LiteGame.Room.Core" Version="0.1.0" />
    <PackageReference Include="LiteGame.Room.Application" Version="0.1.0" />
  </ItemGroup>

  <!-- 服务端配置装载（与客户端同一份 .bytes 二进制）：Luban 运行时与生成表代码
       均为仓库内源码（Packages/com.code-philosophy.luban 为 embedded 包，非本机 file: 依赖），
       源链接共编——两端同代码同数据，物理上不可能漂移。 -->
  <ItemGroup>
    <Compile Include="..\..\Packages\com.code-philosophy.luban\Runtime\*.cs" Link="LubanRuntime\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\GameData\Generated\**\*.cs" Link="LubanGenerated\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Config\Table\SimConfigMapper.cs" Link="LubanMappings\SimConfigMapper.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Config\Table\BattleStrategyTableReader.cs" Link="LubanMappings\BattleStrategyTableReader.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Config\Table\TableLayout.cs" Link="LubanMappings\TableLayout.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Config\Table\MapTableProjection.cs" Link="LubanMappings\MapTableProjection.cs" />
  </ItemGroup>

  <!-- 服务端 NuGet 登记处（依赖治理在服务端侧的承载）：l0-dep-scan 管 Unity manifest/lock 与密钥，
       不管服务端 PackageReference——本 ItemGroup 即登记位置。
       2026-10-08 装配收敛批1（《服务端宿主装配收敛专项设计》）：宿主组合根 MS DI，版本显式钉死。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- 与客户端/MetaServer 同一序列化库：注册心跳与结算载荷的口径单源（WireJsonSettings）。 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Meta HTTP 契约的线形状单源（与客户端 LiteGame.App、MetaServer 编译同一份）：
      注册心跳载荷与房间明细不再在本工程手写镜像 DTO。
    -->
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Core\MetaError.cs" Link="Shared\MetaWire\MetaError.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Login\GuestLoginRequest.cs" Link="Shared\MetaWire\GuestLoginRequest.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Login\GuestLoginInfo.cs" Link="Shared\MetaWire\GuestLoginInfo.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Join\JoinTicketRequest.cs" Link="Shared\MetaWire\JoinTicketRequest.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Lobby\CreateRoomRequest.cs" Link="Shared\MetaWire\CreateRoomRequest.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\JoinTicketInfo.cs" Link="Shared\MetaWire\JoinTicketInfo.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Lobby\RoomsResponse.cs" Link="Shared\MetaWire\RoomsResponse.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Lobby\LobbyInstanceView.cs" Link="Shared\MetaWire\LobbyInstanceView.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Lobby\LobbyRoomEntry.cs" Link="Shared\MetaWire\LobbyRoomEntry.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Match\MatchesResponse.cs" Link="Shared\MetaWire\MatchesResponse.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Match\MatchRecordInfo.cs" Link="Shared\MetaWire\MatchRecordInfo.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Instance\InstanceRegisterRequest.cs" Link="Shared\MetaWire\InstanceRegisterRequest.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Instance\InstanceRegisterResponse.cs" Link="Shared\MetaWire\InstanceRegisterResponse.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Match\MatchResultSubmission.cs" Link="Shared\MetaWire\MatchResultSubmission.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Match\PlayerResultEntry.cs" Link="Shared\MetaWire\PlayerResultEntry.cs" />
    <Compile Include="..\..\Packages\com.litegame.shared\Runtime\MetaWire\Core\MetaWireEndpoints.cs" Link="Shared\MetaWire\MetaWireEndpoints.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 契约序列化行为单源（camelCase/禁日期自动解析/未知字段报错）。 -->
    <Compile Include="..\..\Packages\com.litegame.framework\Runtime\Adapters\Newtonsoft\WireJsonSettings.cs" Link="Shared\MetaWire\WireJsonSettings.cs" />
  </ItemGroup>

</Project>
