<Project Sdk="Microsoft.NET.Sdk">  <!--
    RoomServer（《状态同步实施方案》§4.5：.NET 8 控制台，单进程多房间，权威 Sim——MVP 不拆 Gate/Sim）。
    协议单源红线（§4.6）：直接引用 LiteNet 工程（其中 Protocol/ 纯函数与 Transport/ 分层），
    服务器侧另写消息结构在物理上不可能。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Luban Runtime 的 ByteBuf 用 unsafe 代码块（嵌入式包源链接进来要开这个） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Assets\LiteNet\LiteNet.csproj" />
    <ProjectReference Include="..\..\Assets\LiteSim\Core\LiteSim.Core.csproj" />
    <!-- 房间内核已按《服务端总设计》§7 目标结构独立成项目：
         纯运行时、无 Socket/无文件/无时钟，现由服务端宿主与 Unity 客户端**共编同一份源码**。 -->
    <ProjectReference Include="..\..\Assets\RoomServer\Runtime\RoomServer.Runtime.csproj" />
    <!-- Application 的无 IO 子集（快照管线/会话/账本/票据）同理——本地开发形态在客户端内复用它。 -->
    <ProjectReference Include="..\..\Assets\RoomServer\Application\RoomServer.Application.Runtime.csproj" />
  </ItemGroup>

  <!-- 服务端配置装载（与客户端同一份 .bytes 二进制）：Luban 运行时与生成表代码
       均为仓库内源码（Packages/com.code-philosophy.luban 为 embedded 包，非本机 file: 依赖），
       源链接共编——两端同代码同数据，物理上不可能漂移。 -->
  <ItemGroup>
    <Compile Include="..\..\Packages\com.code-philosophy.luban\Runtime\*.cs" Link="LubanRuntime\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\GameData\Generated\**\*.cs" Link="LubanGenerated\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\LiteClient\Adapters\Serialization.Luban\SimConfigMapper.cs" Link="LubanMappings\SimConfigMapper.cs" />
  </ItemGroup>

  <!-- 服务端 NuGet 登记处（依赖治理在服务端侧的承载）：l0-dep-scan 管 Unity manifest/lock 与密钥，
       不管服务端 PackageReference——本 ItemGroup 即登记位置。
       2026-10-08 装配收敛批1（《服务端宿主装配收敛专项设计》）：宿主组合根 MS DI，版本显式钉死。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

</Project>
