<Project Sdk="Microsoft.NET.Sdk">  <!--
    MetaServer（《Meta 服务专项设计》§4.1 宿主选型裁决、§4.2 目标工程结构）。
    服务端总设计 §6/§11/§12：Generic Host + Options ValidateOnStart + 健康检查 + 优雅关闭。

    依赖红线（§4.1）：Web 面零 NuGet——<FrameworkReference Include="Microsoft.AspNetCore.App" />
    引用已安装共享框架，禁止改用 NuGet Web 包。
    引入 MongoDB.Driver 真 NuGet——§9.1"MongoDB 唯一权威存储"、
    §14 L3"Mongo 测试容器"、§15 G1"存储端口 + 一个持久化样例"共同要求真实驱动；自研线协议被
    §1.1"不自研 HTTP 栈"同一理由否决。驱动只落 Infrastructure/（适配器层），
    Contracts/ 保持零驱动依赖（L0 方向：Contracts 不得引用 Infrastructure）；版本显式钉死。

    LangVersion 10.0（**有意不同于 RoomServer 的 9.0**）：C# 9 下最小 API
    惯用写法（MapGet target-typed lambda / 方法组）全部编译失败（CS1593/CS1503/CS0030），
    只有逐端点显式委托转换可用。档位差异是技术约束，不是配置疏漏。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      服务端 NuGet 登记处（依赖治理在服务端侧的承载）：l0-dep-scan 管 Unity
      manifest/lock 与密钥，不管服务端 PackageReference——本 ItemGroup 即登记位置。
    -->
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <!--
      HTTP 契约的序列化库：与客户端（Unity 包 com.unity.nuget.newtonsoft-json 3.2.1 携带的
      程序集版本 13.0.0.0）同一主版本。**不用** Microsoft.AspNetCore.Mvc.NewtonsoftJson——
      Minimal API 无该挂钩点，且它会引入 MVC 包；服务端经 MetaResults 手写序列化收口。
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Join Ticket 线格式**单源**（《Meta 服务专项设计》§6.2/§7、《上云测试专项设计》§2）：
      Meta 签发端与 RoomServer 验签端必须同一份形状规则（"物理上不会漂"）。以源链接共编——
      与 RoomServer 工程链接 Luban/SimConfigMapper 同款惯例；**不得**在本工程另写第二份拼串。
      本文件只依赖 BCL（System/Security.Cryptography/Text），不引入 LiteNet/proto。
    -->
    <Compile Include="..\..\Assets\RoomServer\Modules\JoinTicketFormat.cs" Link="Shared\JoinTicketFormat.cs" />
    <!--
      Base64Url 编解码单源（P2）：票据线格式（JoinTicketFormat）与访问令牌线格式（AccessTokenFormat）
      此前各手写一份逐字相同的实现，重连票据又写了第三份——本文件即那三处的唯一实现。
      只依赖 BCL（System/System.Text），不引入 LiteNet/proto。
    -->
    <Compile Include="..\..\Assets\RoomServer\Modules\Base64Url.cs" Link="Shared\Base64Url.cs" />
    <!--
      Match 相位词汇与终态判据单源（房间明细批）：Meta 的 phase 闸（InstanceRegistry）此前以字面量
      0..5 + 注释绑内核 MatchPhase（实有 8 值，Closed=6/Aborted=7）——内核新增相位即静默漂移。
      源链接共编后，值域（Created..Aborted）与终态判据（IsTerminal）直接由本枚举派生。
      本文件纯 BCL（无 using），不引入 LiteSim/proto。
    -->
    <Compile Include="..\..\Assets\RoomServer\Core\MatchStateMachine.cs" Link="Shared\MatchStateMachine.cs" />
    <!--
      Meta HTTP 契约的**线形状单源**（客户端 LiteGame.App 编译同一份）：改字段 = 两端同时编译失败。
      三个文件均零引擎、零第三方（属性 POCO / 常量表），可直接进服务端编译。
    -->
    <Compile Include="..\..\Assets\LiteGame\App\Meta\Wire\MetaWireContracts.cs" Link="Shared\MetaWire\MetaWireContracts.cs" />
    <Compile Include="..\..\Assets\LiteGame\App\Meta\Wire\MetaWireEndpoints.cs" Link="Shared\MetaWire\MetaWireEndpoints.cs" />
    <Compile Include="..\..\Assets\LiteGame\App\Meta\Wire\MetaWireLimits.cs" Link="Shared\MetaWire\MetaWireLimits.cs" />
    <!--
      契约序列化行为单源（camelCase + 禁日期自动解析 + 未知字段报错）。它引用 Newtonsoft，
      因此住客户端适配层（R12 允许），服务端链接同一份——**两端的字段名/转义/日期口径只有一个定义**。
    -->
    <Compile Include="..\..\Assets\LiteFramework\Runtime\Adapters\Newtonsoft\WireJsonSettings.cs" Link="Shared\MetaWire\WireJsonSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      本地配置样例（无密钥——键值全空 = 与内联默认等价；实钥本地自填、勿提交）。
      MetaHost 显式从 BaseDirectory 读 appsettings.json（optional）——SDK 非 Web 型
      不自动拷贝，此处 PreserveNewest 保 dotnet run 直达（2026-10-15 本地联测手册 07 §5）。
    -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
