{
  // 本地全链样例（与 Config/roomserver.json 配套）。ASP.NET 配置链允许注释。
  // 密钥三把（32B Base64，[Convert]::ToBase64String((1..32|%{Get-Random -Max 256})) 生成）：
  //   AuthSigningKeyBase64（登录页游客登录必须非空）/ LobbyInstanceKeyBase64 +
  //   LobbyTicketKeyBase64（与 RoomServer --ticket-key l1:<同值> 配对）/
  //   SettlementInstanceKeyBase64（结算账本）。填好后勿提交实钥。
  // Mongo 两键**成对**填（连接串+库名；只填其一半启动即拒——一致性校验）：留空 = 持久化关（能起）。
  // 票据键与 RoomServer 配对：LobbyTicketKeyBase64 = --ticket-key 的 base64 段、
  //   LobbyTicketKeyId = 其 kid（默认 l1）、LobbyTicketAudience = 房间端 --audience（默认 lobby）。
  "Meta": {
    "BindAddress": "http://127.0.0.1:5000",
    "MongoConnectionString": "",
    "MongoDatabaseName": "",
    "AuthSigningKeyBase64": "",
    "LobbyInstanceKeyBase64": "",
    "LobbyTicketKeyBase64": "",
    "LobbyTicketKeyId": "l1",
    "LobbyTicketAudience": "lobby",
    "SettlementInstanceKeyBase64": "",
    "EnableSampleEndpoints": false
  }
}
