<Project Sdk="Microsoft.NET.Sdk">  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- WeakNet 内核源码链接进测试工程：LiteNet.csproj 不定义三宏（服务端/release 不含类型），
         测试侧显式开启宏以编译同一份源码。 -->
    <DefineConstants>$(DefineConstants);LITEFRAMEWORK_DEBUG</DefineConstants>
  </PropertyGroup>  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Packages/com.litegame.net\LiteNet.csproj" />
    <ProjectReference Include="..\..\Packages/com.litegame.sync\LiteSync.csproj" />
    <ProjectReference Include="..\..\Packages/com.litegame.sim\LiteSim.csproj" />
    <ProjectReference Include="..\..\Server\RoomServer\RoomServer.csproj" />
    <ProjectReference Include="..\..\Server\ReplayTool\ReplayTool.csproj" />
    <ProjectReference Include="..\..\Assets\LiteTesting\LiteTesting.Core.csproj" />
    <!-- 全链诊断样例（§8「可诊断」）：内容激活事务面（Core 的 ActivationTransactionStore +
         IDiagRecordSink 端口）与本组的会话/房间面在**一次失败**里对齐——测试项目专用引用，
         不改变生产依赖边界（Core 无引擎引用；服务端/客户端程序集不新增依赖）。 -->
    <ProjectReference Include="..\..\Assets\LiteFramework\LiteFramework.Core.csproj" />
    <ProjectReference Include="..\..\Assets\LiteFramework\Runtime\LiteFramework.Async.csproj" />
  </ItemGroup>

  <!-- DI-3 会话工厂 L1 直测：Account 半边（工厂 + BattleClient）零引擎依赖，按源链接惯例纳入——
       测**真工厂**非复制品（与 LiteSim.Core.Tests 链接 Input 件同款纪律）。
       Match 半边依赖 BattleContext（SimView → UnityEngine），Unity 面，验收归 DI-4。 -->
  <ItemGroup>
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Debug\WeakNet\*.cs" Link="WeakNet\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Debug\Tunables\DebugTunable.cs" Link="WeakNet\DebugTunable.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\Abstractions\IMatchJoin.cs" Link="Session\IMatchJoin.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\Abstractions\IAccountSessionFactory.cs" Link="Session\IAccountSessionFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\Abstractions\IAccountSession.cs" Link="Session\IAccountSession.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\AccountSessionFactory.cs" Link="Session\AccountSessionFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\MatchTransport.cs" Link="Session\MatchTransport.cs" />
    <!-- 端口与客户端工厂（A1 解耦）：Account 会话工厂只经端口建客户端，工厂本体在 Battle 域——
         同一份源码按惯例源链接进本工程（测真实现非复制品；AC1「唯一 new BattleClient 处」在此件）。 -->
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Abstractions\IBattleClient.cs" Link="Session\IBattleClient.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Abstractions\IBattleClientFactory.cs" Link="Session\IBattleClientFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Abstractions\IAccountRuntime.cs" Link="Session\IAccountRuntime.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\BattleClientFactory.cs" Link="Session\BattleClientFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\BattleClient.cs" Link="Session\BattleClient.cs" />
    <!-- 测试地图夹具源链接：与 LiteSim.Core.Tests 共编同一份 TestMaps（单源）——StandardBattleMap 退役后测试侧地图单源 -->
    <Compile Include="..\LiteSim.Core.Tests\TestMaps.cs" Link="Test\TestMaps.cs" />
    <Compile Include="..\LiteSim.Core.Tests\TestWeapons.cs" Link="Test\TestWeapons.cs" />
  </ItemGroup>

</Project>
