<Project Sdk="Microsoft.NET.Sdk">  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- WeakNet 内核源码链接进测试工程：LiteNet.csproj 不定义三宏（服务端/release 不含类型），
         测试侧显式开启宏以编译同一份源码。 -->
    <DefineConstants>$(DefineConstants);LITEFRAMEWORK_DEBUG</DefineConstants>
  </PropertyGroup>  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Packages/com.litegame.net\LiteNet.csproj" />
    <ProjectReference Include="..\..\Packages/com.litegame.sync\LiteSync.csproj" />
    <ProjectReference Include="..\..\Packages/com.litegame.sim\LiteSim.csproj" />
    <ProjectReference Include="..\..\Server\RoomServer\RoomServer.csproj" />
    <ProjectReference Include="..\..\Server\ReplayTool\ReplayTool.csproj" />
    <ProjectReference Include="..\..\Assets\LiteTesting\LiteTesting.Core.csproj" />
    <ProjectReference Include="..\..\Packages\com.litegame.framework\LiteFramework.Core.csproj" />
    <!-- 会话工厂的 HandshakeIdentity 契约由 LiteFramework.Async 提供。 -->
    <ProjectReference Include="..\..\Packages\com.litegame.framework\Runtime\LiteFramework.Async.csproj" />
  </ItemGroup>

  <!-- DI-3 会话工厂 L1 直测：Account 半边（工厂 + BattleClient）零引擎依赖，按源链接惯例纳入——
       测**真工厂**非复制品（与 LiteSim.Core.Tests 链接 Input 件同款纪律）。
       Match 半边依赖 BattleContext（SimView → UnityEngine），Unity 面，验收归 DI-4。 -->
  <ItemGroup>
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Debug\WeakNet\Commands\*.cs" Link="WeakNet\Commands\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Debug\WeakNet\Profile\*.cs" Link="WeakNet\Profile\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Debug\WeakNet\Stats\*.cs" Link="WeakNet\Stats\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Debug\WeakNet\Transport\*.cs" Link="WeakNet\Transport\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Debug\Tunables\DebugTunable.cs" Link="WeakNet\DebugTunable.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\Abstractions\IMatchJoin.cs" Link="Session\IMatchJoin.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\Abstractions\IMatchSessionFactory.cs" Link="Session\IMatchSessionFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\Abstractions\IMatchSession.cs" Link="Session\IMatchSession.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\MatchSessionFactory.cs" Link="Session\MatchSessionFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Session\Transport\MatchTransport.cs" Link="Session\MatchTransport.cs" />
    <!-- 端口与客户端工厂（A1 解耦）：Account 会话工厂只经端口建客户端，工厂本体在 Battle 域——
         同一份源码按惯例源链接进本工程（测真实现非复制品；AC1「唯一 new BattleClient 处」在此件）。 -->
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Abstractions\Run\IBattleClient.cs" Link="Session\IBattleClient.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Abstractions\Run\IBattleClientFactory.cs" Link="Session\IBattleClientFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Abstractions\Session\IMatchRuntime.cs" Link="Session\IMatchRuntime.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Hosting\Client\BattleClientFactory.cs" Link="Session\BattleClientFactory.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Battle\Hosting\Client\BattleClient.cs" Link="Session\BattleClient.cs" />
    <!-- 测试地图夹具源链接：与 LiteSim.Core.Tests 共编同一份 TestMaps（单源）——StandardBattleMap 退役后测试侧地图单源 -->
    <Compile Include="..\LiteSim.Core.Tests\TestMaps.cs" Link="Test\TestMaps.cs" />
    <Compile Include="..\LiteSim.Core.Tests\TestWeapons.cs" Link="Test\TestWeapons.cs" />
  </ItemGroup>

</Project>
