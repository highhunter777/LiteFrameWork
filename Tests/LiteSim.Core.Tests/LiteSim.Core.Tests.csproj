<Project Sdk="Microsoft.NET.Sdk">  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Assets\LiteSim\Core\LiteSim.Core.csproj" />
    <ProjectReference Include="..\..\Assets\LiteTesting\LiteTesting.Core.csproj" />
  </ItemGroup>

  <!--
    表现变换纯函数的 L1 覆盖（《M11实施指导》§2.4 C3 明确要求："插值/衰减抽成纯函数
    （ViewTransformMath，无引擎依赖）→ 进 Tests/LiteSim.Core.Tests（L1 覆盖）"）。
    LiteSim.View 程序集引 UnityEngine，L1 项目不能 ProjectReference 它；
    该文件本身零引擎依赖，故按源**链接编译**——单一来源，语义不可能在两侧漂移。
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\LiteSim\View\ViewTransformMath.cs" Link="View\ViewTransformMath.cs" />
  </ItemGroup>

  <!--
    输入服务的 L1 覆盖：三个门（上下文门/帧边界门/采样节流）全是纯逻辑，按项目既有口径
    用**源链接**纳入 L1——同一份 .cs 既被 Unity（LiteClient.Runtime）编，也被 L1 编，
    不靠程序集引用（那需要 UnityEngine，L1 编不了）。前置契约在别处已由 L1 覆盖
    （RollbackSim 的 OnRealInput 入史语义），这里只钉输入服务自己那一段。
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\LiteClient\Runtime\Input\InputService.cs" Link="Input\InputService.cs" />
    <Compile Include="..\..\Assets\LiteClient\Runtime\Input\IntentGate.cs" Link="Input\IntentGate.cs" />
    <Compile Include="..\..\Assets\LiteClient\Runtime\Input\IIntentSource.cs" Link="Input\IIntentSource.cs" />
    <Compile Include="..\..\Assets\LiteClient\Runtime\Input\IInputService.cs" Link="Input\IInputService.cs" />
    <!--
      **平台实现不在 L1**：`NewInputIntentSource` / `CinemachineCameraService`（`Adapters/Platform.Unity/`）
      引 UnityEngine / Unity.InputSystem / Cinemachine，链接进来需要 Unity 托管与包引用，而本仓测试项目
      约定**不写 Unity 安装路径**（§14.1 禁个人绝对路径）。它们的编译由夜间 L2 门禁覆盖，
      行为归 PlayMode/Player 验证。L1 只覆盖无引擎依赖的裁决核心（三个门 + 端口契约）。
    -->
  </ItemGroup>

  <ItemGroup>
    <None Update="Baselines\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
