<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- GmSceneCommands（源链接纳入，见下方链接组）的三宏守卫激活：与 LiteFramework.Core.csproj 同用
         LITEFRAMEWORK_DEBUG。宏影响面已核查——既有测试源无条件编译段（DisciplineScannerTests 的 #if 命中
         是字符串字面量）；Core/Async 经 ProjectReference 编译不受本工程宏影响。 -->
    <DefineConstants>$(DefineConstants);LITEFRAMEWORK_DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Assets\LiteFramework\LiteFramework.Core.csproj" />
    <ProjectReference Include="..\..\Assets\LiteFramework\Runtime\Modules\LiteFramework.Async.csproj" />
    <ProjectReference Include="..\..\Assets\Tools\DisciplineScanner\DisciplineScanner.csproj" />
    <ProjectReference Include="..\..\Assets\LiteTesting\LiteTesting.Core.csproj" />
  </ItemGroup>

  <!--
    GM 场景命令的 L1 覆盖（《GM 与调试工具分层设计》§2 场景操作命令化批）：按源链接纳入——
    ISceneService 是 LiteFramework.Unity 的服务端口（零引擎依赖，UniTask 经 LiteFramework.Async 双轨提供）；
    GmSceneCommands（命令族+处理器+注册面）住 LiteGame App，同份 .cs 两侧编译（ViewTransform 先例）。
    只覆盖命令派发与注册协议（参数校验/对应操作派发/权限门/审计）；SceneService 实现（YooAsset 适配器）
    归 L2——机制不在本测试工程。
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\LiteFramework\Runtime\Modules\Scene\Abstractions\ISceneService.cs" Link="Gm\ISceneService.cs" />
    <Compile Include="..\..\Assets\LiteGame\Adapters\Dev\Commands\GmSceneCommands.cs" Link="Gm\GmSceneCommands.cs" />
  </ItemGroup>

  <!--
    M3-6 / M3-5c 恢复面的 L1 覆盖：内容受控缓存清理（LiteClient 零引擎）与账号重入单点（App 零引擎端口）
    按源链接纳入——真件行为在 L1 直测，Unity 面只提供 ILoginSurface/IContentService 实现。
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\LiteFramework\Runtime\Modules\Content\ReleaseLayout.cs" Link="Content\ReleaseLayout.cs" />
    <Compile Include="..\..\Assets\LiteFramework\Runtime\Modules\Content\ContentCacheMaintenance.cs" Link="Content\ContentCacheMaintenance.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\AccountReentry.cs" Link="Meta\AccountReentry.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\Abstractions\IAccountSessionControl.cs" Link="Meta\Abstractions\IAccountSessionControl.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\Abstractions\IAppFlow.cs" Link="Meta\Abstractions\IAppFlow.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\MetaJoin.cs" Link="Meta\MetaJoin.cs" />
  </ItemGroup>

  <!--
    Meta 网络契约的 L1 覆盖：客户端本地契约 + 共享线形状 + 编解码/校验按源链接纳入
    （全部零引擎、零第三方——IJsonCodec/IJsonNode 经 LiteFramework.Core 工程引用取得）。
    形状单源与必填校验在 L1 直测；Newtonsoft 适配行为（未知字段拒绝等）由
    Assets/Tests/EditMode/MetaClientEditModeTests 经真实 HTTP 覆盖。
  -->
  <ItemGroup>
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\MetaContracts.cs" Link="Meta\MetaContracts.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\MetaJson.cs" Link="Meta\MetaJson.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\MetaWireValidator.cs" Link="Meta\MetaWireValidator.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\Wire\MetaWireContracts.cs" Link="Meta\Wire\MetaWireContracts.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\Wire\MetaWireEndpoints.cs" Link="Meta\Wire\MetaWireEndpoints.cs" />
    <Compile Include="..\..\Assets\LiteGame\Modules\Meta\Wire\MetaWireLimits.cs" Link="Meta\Wire\MetaWireLimits.cs" />
  </ItemGroup>

</Project>
