<Project Sdk="Microsoft.NET.Sdk">  <!--
     MetaServer 测试工程。命名必须是 *.Tests.csproj——scripts/test.ps1 以该通配符发现测试工程
     （`Get-ChildItem -Recurse -Filter '*.Tests.csproj'`），改名会被静默漏跑。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      被引用即进入 Tests.slnx 的 restore 图。test.ps1 只 restore 测试工程，随后以 no-restore 方式
      构建 slnx；若 slnx 里的非测试工程没有任何测试工程引用它，构建会直接失败。
    -->
    <ProjectReference Include="..\..\Server\MetaServer\MetaServer.csproj" />
    <ProjectReference Include="..\..\Assets\LiteTesting\LiteTesting.Core.csproj" />
    <!--
      房间端票据验证器（L3 跨端闭环：Meta 签发 → RoomServer 验签 同源证明）。测试项目专用引用，
      不改变生产依赖边界（MetaServer.exe 本身不引用房间程序集——签发走源链接的 JoinTicketFormat 单源）。
      注意：JoinTicketFormat 类型同时存在于两个程序集（源链接共编），**测试代码不得直接命名该类型**
      （CS0433）；断言走字符串拆段或直接走验证器。
    -->
    <ProjectReference Include="..\..\Assets\RoomServer\Application\RoomServer.Application.Runtime.csproj" />
    <!-- 房间侧注册客户端（L3 闭环：真 LobbyRegistrationClient → 真 Meta HTTP）。同为测试项目专用引用。 -->
    <ProjectReference Include="..\..\Server\RoomServer\RoomServer.csproj" />
  </ItemGroup>

</Project>
