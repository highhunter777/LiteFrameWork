  "stages": [
    {
      "id": "propose",
      "title": "提出方案",
      "artifacts": [
        {
          "path": "plan.md",
          "template": "plan.md",
          "sections": [
            "背景与目标",
            "需求澄清与假设",
            "范围与非目标",
            "现状与约束",
            "候选方案与取舍",
            "设计要点",
            "通用性与扩展性",
            "测试策略",
            "验收标准",
            "风险与回滚"
          ]
        }
      ]
    },
    {
      "id": "review-plan",
      "title": "子代理评审方案",
      "artifacts": [
        {
          "path": "reviews/plan-review.md",
          "template": "reviews/plan-review.md",
          "sections": [
            "评审输入",
            "方案检查",
            "验收标准可判定性",
            "发现的问题与处理",
            "评审结论"
          ]
        }
      ],
      "verdicts": [
        {
          "path": "reviews/plan-review.md",
          "fields": {
            "评审方式": [
              "独立子代理"
            ],
            "结论": [
              "PASS",
              "通过"
            ],
            "验收标准": [
              "PASS",
              "通过"
            ],
            "阻塞问题": [
              "0",
              "无"
            ]
          }
        }
      ]
    },
    {
      "id": "confirm-acceptance",
      "title": "用户确认验收标准",
      "artifacts": [
        {
          "path": "acceptance.md",
          "template": "acceptance.md",
          "sections": [
            "验收标准",
            "提审记录",
            "用户确认",
            "变更记录"
          ]
        }
      ],
      "verdicts": [
        {
          "path": "acceptance.md",
          "fields": {
            "确认结论": [
              "通过",
              "确认"
            ]
          }
        }
      ],
      "approval": true
    },
    {
      "id": "breakdown",
      "title": "实施任务清单",
      "artifacts": [
        {
          "path": "tasks.md",
          "sections": [
            "任务清单"
          ]
        }
      ],
      "min_tasks": 1
    },
    {
      "id": "review-tasks",
      "title": "评审任务",
      "artifacts": [
        {
          "path": "reviews/task-review.md",
          "template": "reviews/task-review.md",
          "sections": [
            "评审输入",
            "覆盖与追溯",
            "检查项",
            "发现的问题与处理",
            "评审结论"
          ]
        }
      ],
      "verdicts": [
        {
          "path": "reviews/task-review.md",
          "fields": {
            "结论": [
              "PASS",
              "通过"
            ],
            "阻塞问题": [
              "0",
              "无"
            ]
          }
        }
      ]
    },
    {
      "id": "tests-first",
      "title": "先写测试",
      "artifacts": [
        {
          "path": "test-plan.md",
          "template": "test-plan.md",
          "sections": [
