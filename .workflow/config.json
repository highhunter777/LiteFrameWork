{
  "schema_version": 1,
  "validation": {
    "placeholders": [
      "待填写"
    ],
    "min_section_chars": 1
  },
  "timeout_seconds": 600,
  "commands": [
    {
      "name": "L1",
      "cmd": [
        "python",
        "scripts/gate/test.py",
        "--lane",
        "L1",
        "--profile",
        "PullRequest"
      ],
      "timeout": 900
    },
    {
      "name": "doc",
      "cmd": [
        "python",
        "scripts/gate/doc-lint.py"
      ],
      "timeout": 300
    },
    {
      "name": "restore",
      "cmd": [
        "python",
        "scripts/gate/restore-check.py"
      ],
      "timeout": 300
    },
    {
      "name": "l0",
      "cmd": [
        "python",
        "-m",
        "unittest",
        "scripts.tests.test_l0_dep_scan",
        "-v"
      ],
      "timeout": 300
    },
    {
      "name": "toolchain-tests",
      "cmd": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "timeout": 300
    },
    {
      "name": "toolchain-check",
      "cmd": [
        "python",
        "scripts/toolchain.py",
        "check"
      ],
      "timeout": 300
    },
    {
      "name": "toolchain-docs-check",
      "cmd": [
        "python",
        "scripts/toolchain.py",
        "docs",
        "--check"
      ],
      "timeout": 300
    },
    {
      "name": "doc-lane",
      "cmd": [
        "python",
        "scripts/gate/test.py",
        "--lane",
        "Doc"
      ],
      "timeout": 300
