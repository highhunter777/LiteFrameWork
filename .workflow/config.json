{
  "schema_version": 1,
  "validation": {
    "placeholders": [
      "待填写"
    ],
    "min_section_chars": 1
  },
  "timeout_seconds": 600,
  "preferences": {
    "task_review": "skip",
    "tests_and_implementation": "subagent",
    "note": "2026-11-09 用户裁决：任务清单不做子代理评审；测试与施工由子代理执行。"
  },
  "commands": [
    {
      "name": "L1",
      "cmd": [
        "python",
        "scripts/gate/test.py",
        "--suite",
        "L1",
        "--profile",
        "PullRequest"
      ],
      "timeout": 900
    },
    {
      "name": "arch-check",
      "cmd": [
        "python",
        "scripts/gate/arch-check.py",
        "--check"
      ],
      "timeout": 120
    },
    {
      "name": "doc-lane",
      "cmd": [
        "python",
        "scripts/gate/test.py",
        "--suite",
        "Doc"
      ],
      "timeout": 300
    },
    {
      "name": "build-hash-shared",
      "cmd": [
        "python",
        "scripts/codegen/toolbox.py",
        "build-hash",
        "--check-shared"
      ],
      "timeout": 300
    },
    {
      "name": "hot-boundary",
      "cmd": [
        "python",
        "scripts/gate/hot-boundary-check.py"
      ],
      "timeout": 120
    },
    {
      "name": "settings-playmode",
      "cmd": [
        "python",
        "scripts/gate/unity-tests.py",
        "--mode",
        "playmode",
        "--filter",
        "SettingsPagePlayModeTests"
      ],
      "timeout": 900
    },
    {
      "name": "toolchain-docs",
      "cmd": [
        "python",
        "scripts/toolchain.py",
        "docs",
        "--check"
      ],
      "timeout": 120
    }
  ],
  "red_commands": [
    {
      "name": "friend-settings-structural-red",
      "cmd": [
        "dotnet",
        "test",
        "Tests/LiteFramework.Core.Tests/LiteFramework.Core.Tests.csproj",
        "--filter",
        "FullyQualifiedName~ModuleFriendAllowlistTests|FullyQualifiedName~SettingsPortMigrationTests",
        "--nologo"
      ],
      "timeout": 600
    },
    {
      "name": "client-next-architecture-red",
      "cmd": [
        "dotnet",
        "test",
        "Tests/LiteFramework.Core.Tests/LiteFramework.Core.Tests.csproj",
        "--filter",
        "FullyQualifiedName~ClientNextArchitectureTests",
        "--nologo"
      ],
      "timeout": 600
    }
  ],
  "stages": [
    {
      "id": "propose",
      "title": "提出方案",
      "artifacts": [
        {
          "path": "plan.md",
          "template": "plan.md",
          "sections": [
            "背景与目标",
            "需求澄清与假设",
            "范围与非目标",
            "现状与约束",
            "候选方案与取舍",
            "设计要点",
            "通用性与扩展性",
            "测试策略",
            "验收标准",
            "风险与回滚"
          ]
        }
      ]
    },
    {
      "id": "review-plan",
      "title": "子代理评审方案",
      "artifacts": [
        {
          "path": "reviews/plan-review.md",
          "template": "reviews/plan-review.md",
          "sections": [
            "评审输入",
            "方案检查",
            "验收标准可判定性",
            "发现的问题与处理",
            "评审结论"
          ]
        }
      ],
      "verdicts": [
        {
          "path": "reviews/plan-review.md",
          "fields": {
            "评审方式": [
              "独立子代理"
            ],
            "结论": [
              "PASS",
              "通过"
            ],
            "验收标准": [
              "PASS",
              "通过"
            ],
            "阻塞问题": [
              "0",
              "无"
            ]
          }
        }
      ]
    },
    {
      "id": "confirm-acceptance",
      "title": "用户确认验收标准",
      "artifacts": [
        {
          "path": "acceptance.md",
          "template": "acceptance.md",
          "sections": [
            "验收标准",
            "提审记录",
            "用户确认",
            "变更记录"
          ]
        }
      ],
      "verdicts": [
        {
          "path": "acceptance.md",
          "fields": {
            "确认结论": [
              "通过",
              "确认"
            ]
          }
        }
      ],
      "approval": true
    },
    {
      "id": "breakdown",
      "title": "实施任务清单",
      "artifacts": [
        {
          "path": "tasks.md",
          "sections": [
            "任务清单"
          ]
        }
      ],
      "min_tasks": 1
    },
    {
      "id": "review-tasks",
      "title": "任务评审（本仓默认跳过：2026-11-09 用户裁决）",
      "artifacts": [],
      "verdicts": [],
      "note": "本仓默认不设子代理任务评审；测试与施工由子代理执行。"
    },
    {
      "id": "tests-first",
      "title": "子代理先写测试",
      "artifacts": [
        {
          "path": "test-plan.md",
          "template": "test-plan.md",
          "sections": [
            "测试策略",
            "用例清单",
            "预期失败证据",
            "运行方式"
          ]
        }
      ],
      "require_red_verification": true
    },
    {
      "id": "implement",
      "title": "子代理正式施工",
      "artifacts": [
        {
          "path": "build-log.md",
          "template": "build-log.md",
          "sections": [
            "施工记录",
            "关键决定",
            "偏差与处理",
            "问题与修复"
          ]
        }
      ],
      "require_tasks_complete": true
    },
    {
      "id": "verify",
      "title": "测试代码",
      "require_tasks_complete": true,
      "require_verification": true
    },
    {
      "id": "review-code",
      "title": "主代理评审代码",
      "artifacts": [
        {
          "path": "reviews/code-review.md",
          "template": "reviews/code-review.md",
          "sections": [
            "变更范围",
            "正确性与边界",
            "测试充分性",
            "通用性与扩展性",
            "安全与性能",
            "发现的问题与处理",
            "复测记录",
            "评审结论"
          ]
        }
      ],
      "verdicts": [
        {
          "path": "reviews/code-review.md",
          "fields": {
            "评审方式": [
              "主代理"
            ],
            "结论": [
              "PASS",
              "通过"
            ],
            "阻塞问题": [
              "0",
              "无"
            ],
            "通用性": [
              "PASS",
              "通过"
            ],
            "扩展性": [
              "PASS",
              "通过"
            ]
          }
        }
      ],
      "require_tasks_complete": true,
      "require_verification": true
    },
    {
      "id": "writeback",
      "title": "回写与收尾",
      "artifacts": [
        {
          "path": "tasks.md",
          "sections": [
            "任务清单"
          ]
        },
        {
          "path": "build-log.md",
          "sections": [
            "交付摘要",
            "验证结果",
            "未决事项",
            "文件清单",
            "后续建议"
          ]
        }
      ],
      "require_tasks_complete": true,
      "require_verification": true
    }
  ]
}
