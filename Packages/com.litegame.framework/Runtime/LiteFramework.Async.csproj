<Project Sdk="Microsoft.NET.Sdk">

  <!--
    双轨编译（测试开发方案 §1.2）：LiteFramework.Async 在 Unity（asmdef）与 dotnet（本 csproj）两侧编译。

    **为什么单列一个程序集**（《客户端与服务端共享代码范围专项设计》§7-4）：
    `LiteFramework.Core` 是 **S2 契约共享**档位——义务是"零引擎 + **零第三方实现依赖**"
    （S2 与 S1 的分界线）。Core 声明零第三方实现依赖；引 UniTask 的件外提到本程序集，
    Core 才真正名实相符。

    **边界**：本程序集**带 UniTask**，故**不是 S2**（不得被服务端产线当契约层引用）；
    它服务客户端异步面，`noEngineReferences: true` 仍保持（可 dotnet 侧编译）。

    - 范围锁死本目录（csproj 与源码同目录，与既有双编惯例一致；glob 排除 .dotnet/ 产物——MSBuild 的 ** 不忽略点目录）
    - EnableDefaultCompileItems=false：同 Core（SDK 默认 glob 会把 Unity 层源码扫进来）
    - LangVersion 9.0：与 Unity 侧 C# 能力对齐，防双轨漂移
    - 产物重定向由同目录 Directory.Build.props 负责（Unity 会把 Assets 下的 bin/obj 当插件导入）
    - Unity 忽略 .csproj，本文件入库仅供 dotnet 使用
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);LITEFRAMEWORK_DEBUG</DefineConstants>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Hosting/**/*.cs" Exclude="Hosting/AppLifetime.cs;Hosting/FrameworkInfrastructure.cs;Hosting/Diagnostics/StructuredLogInstaller.cs;Hosting/Diagnostics/ClientDiagnosticsBundle.cs" />
    <Compile Include="Services/Config/**/*.cs" />
    <!-- Unity 资源/组件载体（ScriptableObject/MonoBehaviour/Animator）不入 dotnet 双轨 -->
    <Compile Include="Services/Animation/**/*.cs" Exclude="Services/Animation/AnimationClipManifest.cs;Services/Animation/LiteAnimator.cs;Services/Animation/Abstractions/IAnimationBackendFactory.cs;Services/Animation/Abstractions/IAnimationPlaybackBackend.cs" />
    <Compile Include="Services/Localization/**/*.cs" />
    <Compile Include="Services/Settings/**/*.cs" />
    <Compile Include="Services/Content/Abstractions/**/*.cs" />
    <Compile Include="Services/Content/ActivationTransactionStore.cs" />
    <Compile Include="Services/Content/CompositeHealthCheck.cs" />
    <Compile Include="Services/Content/PatchCoordinator.cs" />
    <Compile Include="Services/Content/SharedLoadCoordinator.cs" />
    <Compile Include="Services/Content/ContentCacheMaintenance.cs" />
    <Compile Include="Services/Content/ContentDeployConfig.cs" />
    <Compile Include="Services/Content/DriveInfoSpaceProbe.cs" />
    <Compile Include="Services/Content/WriteProbeDiskSpaceProbe.cs" />
    <Compile Include="Services/Content/UnavailableDiskSpaceProbe.cs" />
    <Compile Include="Services/Content/FileActivationRecordIO.cs" />
    <Compile Include="Services/Content/ReleaseLayout.cs" />
    <Compile Include="Services/Content/CandidateBundleRootResolver.cs" />
    <Compile Include="Services/Content/PlayerCapabilities.cs" />
    <Compile Include="Services/TaskObservation.cs" />
    <!-- SignedManifestEnvelope/TrustedKeyStore 引 Newtonsoft（Unity 侧自动引用），不入 dotnet 双轨 -->
    <Compile Include="Services/Content/PatchRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteFramework.Core.csproj" />
    <!-- UniTask：nuget.org 包 ID 为 "UniTask"（Cysharp 发布）；版本与 Unity 侧
         Assets/ThirdParty/Plugins/UniTask（com.cysharp.unitask 2.5.11）对齐。
         **唯一**保留 UniTask 的框架工程（Core 已摘除）。 -->
    <PackageReference Include="UniTask" Version="2.5.11" />
  </ItemGroup>

</Project>
