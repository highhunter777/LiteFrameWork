<Project>

  <!--
    双轨编译产物重定向：dotnet 侧的 bin/obj 不落在 Assets 目录内。
    **为什么必须**：Unity 会把 Assets/ 下的 bin/*.dll 当插件导入，与 asmdef 编出的同名程序集
    撞车（CS1704 "same simple name has already been imported"），同时会扫描 obj/ 里的生成 .cs。
    点开头的目录（.dotnet/）Unity 资产数据库直接忽略。
    （与 Assets/LiteFramework、Assets/LiteSim、Assets/LiteNet 的 Directory.Build.props 同款。）
  -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>.dotnet/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>.dotnet/bin/</BaseOutputPath>
  </PropertyGroup>

</Project>
