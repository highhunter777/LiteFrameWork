<Project Sdk="Microsoft.NET.Sdk">  <!--
    双轨编译（测试开发方案 §1.2）：LiteSim.Core 在 Unity（asmdef）与 dotnet（本 csproj）两侧编译。
    - 范围锁死 Scripts/ 运行时代码：Core 是 references:[] 零依赖程序集（noEngineReferences:true），纯 BCL
    - Systems/ 同为运行时代码，与 Scripts/ 平级，故显式 include
    - Editor/ 与 Scripts/Editor 用 UnityEditor，不进双轨（UnityEditor 命名空间 dotnet 侧编不过）
    - EnableDefaultCompileItems=false：SDK 默认 glob 会把 Editor/Unity 层扫进来，必须关掉改为显式 include
    - LangVersion 9.0：与 Unity 侧 C# 能力对齐，防双轨漂移（dotnet 侧先用了 Unity 编不了的语法 = 假绿）
    - Unity 忽略 .csproj，本文件入库仅供 dotnet（测试）使用
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Scripts/**/*.cs" Exclude="Scripts/Editor/**/*.cs" />
    <Compile Include="Systems/**/*.cs" />
    <!-- Diagnostics/：回放录制/离线复算/字段级 diff。纯 BCL（只用 SimChecksum/SimStep/SimWorldState），
         与 Systems/ 同为运行时代码，双轨可编。 -->
    <Compile Include="Diagnostics/**/*.cs" />
    <!-- Properties/AssemblyInfo.cs：InternalsVisibleTo（测试可见 internal 生成物） -->
    <Compile Include="Properties/**/*.cs" />
  </ItemGroup>

</Project>
