{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litegame:ui:rule-exceptions:1.0",
  "title": "UiRuleExceptions",
  "description": "UI 校验例外登记（手工维护的配置，不是生成物）：命中且未过期的问题降级一级并在报文标注；过期/非法条目自身报问题。口径见 UI编辑器工具链专项设计 §6.3。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exceptions"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "asset", "owner", "reason", "expiry"],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^ui\\.[a-z0-9-]+$",
          "description": "规则标识（与报告 ruleId 一致，如 ui.page-structure）。"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "description": "资产路径（工程根相对）；支持任意位置 * 通配。"
        },
        "node": {
          "type": "string",
          "description": "节点路径；空＝该资产任意节点；支持任意位置 * 通配。"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "例外责任人。"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "理由（为什么允许暂时存在）。"
        },
        "expiry": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "到期日 yyyy-MM-dd（当天仍有效；次日起失效，问题回到原级别）。"
        }
      }
    }
  }
}
