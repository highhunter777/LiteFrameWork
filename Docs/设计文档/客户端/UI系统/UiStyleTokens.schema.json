{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litegame:ui:style-tokens:2.0",
  "title": "UiStyleTokens",
  "description": "UI 设计令牌的 JSON 源格式：颜色/字体/间距/圆角/阴影/动效/图标。生成 UiThemeAsset 供 Unity 读面；运行时通过 UiStyleResolver 解析，不直接读本文件。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "groups"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "theme"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "typography", "spacing", "radius", "elevation", "motion", "icon"],
      "properties": {
        "color": { "$ref": "#/$defs/colorGroup" },
        "typography": { "$ref": "#/$defs/typographyGroup" },
        "spacing": { "$ref": "#/$defs/spacingGroup" },
        "radius": { "$ref": "#/$defs/radiusGroup" },
        "elevation": { "$ref": "#/$defs/elevationGroup" },
        "motion": { "$ref": "#/$defs/motionGroup" },
        "icon": { "$ref": "#/$defs/iconGroup" }
      }
    }
  },
  "$defs": {
    "tokenId": {
      "type": "string",
      "pattern": "^(color|font|space|radius|elev|motion|ease|icon)\\.[a-z0-9]+(\\.[a-z0-9]+)*$"
    },
    "colorValue": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
    },
    "colorGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tokenId" },
          "additionalProperties": { "$ref": "#/$defs/colorToken" }
        }
      }
    },
    "colorToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "$ref": "#/$defs/colorValue" },
        "description": { "type": "string" }
      }
    },
    "typographyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tokenId" },
          "additionalProperties": { "$ref": "#/$defs/typographyToken" }
        }
      }
    },
    "typographyToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "fontSize", "lineHeight", "weight"],
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1 },
        "fontSize": { "type": "number", "minimum": 8, "maximum": 96 },
        "lineHeight": { "type": "number", "minimum": 1, "maximum": 2 },
        "weight": { "enum": ["Regular", "Medium", "Bold"] },
        "letterSpacing": { "type": "number" },
        "description": { "type": "string" }
      }
    },
    "spacingGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tokenId" },
          "additionalProperties": { "$ref": "#/$defs/numberToken" }
        }
      }
    },
    "radiusGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tokenId" },
          "additionalProperties": { "$ref": "#/$defs/numberToken" }
        }
      }
    },
    "elevationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tokenId" },
          "additionalProperties": { "$ref": "#/$defs/elevationToken" }
        }
      }
    },
    "elevationToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "offsetX", "offsetY", "blur", "spread"],
      "properties": {
        "color": { "$ref": "#/$defs/colorValue" },
        "offsetX": { "type": "number" },
        "offsetY": { "type": "number" },
        "blur": { "type": "number", "minimum": 0 },
        "spread": { "type": "number" },
        "description": { "type": "string" }
      }
    },
    "motionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tokenId" },
          "additionalProperties": { "$ref": "#/$defs/motionToken" }
        }
      }
    },
    "motionToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs"],
      "properties": {
        "durationMs": { "type": "number", "minimum": 0, "maximum": 5000 },
        "easing": { "type": "string", "description": "缓动曲线 ID 或表达式；具体格式由解析器定义。" },
        "description": { "type": "string" }
      }
    },
    "iconGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/tokenId" },
          "additionalProperties": { "$ref": "#/$defs/numberToken" }
        }
      }
    },
    "numberToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "number" },
        "description": { "type": "string" }
      }
    }
  }
}
