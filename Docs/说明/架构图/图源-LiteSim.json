  "cards": [
    {
      "dot": "cyan",
      "title": "九系统的固定顺序（SimStep）",
      "items": [
        "① 复活 Respawn → ② 输入 Input → ③ 移动 Movement → ④ 武器 Weapon → ⑤ 射击 Shooting",
        "⑥ 伤害 Damage + ⑦ 计分 Score：走命令缓冲，最多 3 轮，轮内新命令进下一轮窗口",
        "⑧ 清理 Cleanup → 帧号 +1 → ⑨ 对局裁决 MatchSystem.Tick",
        "已结束的对局进来即清命令短路返回（Finished 早退）"
      ]
    },
    {
      "dot": "emerald",
      "title": "确定性的硬约束",
      "items": [
        "禁超越函数 / FMA / float 等值比较（R1/R2/R3 扫描 + IEEE 基线用例）",
        "SimMath 自带软件 sqrt 与三角表；SimRng 单源，不用系统随机",
        "双轨共编：Unity asmdef（noEngineReferences）+ dotnet csproj 编同一份源码",
        "输入先按 EntityId 稳定插入排序（零分配、禁用 LINQ 与库排序）"
      ]
    },
    {
      "dot": "violet",
      "title": "状态与快照",
      "items": [
        "SimWorldState 就地读写：定容 EntitySlot、位图存活集，判定路径零分配",
        "SnapshotRing 保存最近若干帧，回滚时从环里取历史帧重放",
        "FrameEventBuffer 记录帧事件供表现侧消费（回滚期静默门）",
        "SimChecksum 逐帧摘要：客户端与权威比对，就是和解的判据"
      ]
    },
    {
      "dot": "amber",
      "title": "回滚、复盘与对账",
      "items": [
        "RollbackSim：预测步进 → 权威快照覆盖 → 用 InputHistory 里的“当时输入”重放",
        "SimReplayRunner 离线复算、SimWorldDiff 字段级比对，定位“哪一步先分叉”",
        "IeeeProbe 对账浮点行为，防止编译器/平台差异漏进判定",
        "判定参数只经实例传递（R13），机制面不读静态可变读数"
      ]
    }
  ]
}
