  "cards": [
    {
      "dot": "cyan",
      "title": "三份关键数据",
      "items": [
        "SimInputFrame：一帧全体玩家的输入数组，客户端预测与上行是同一份",
        "StateSnapshot：服务器权威态（30Hz 差分 + AOI），走不可靠通道",
        "SimWorldState：客户端世界态——预测写一份，权威镜像写另一份，永不互相回灌"
      ]
    },
    {
      "dot": "emerald",
      "title": "权威与预测的边界",
      "items": [
        "客户端 predict 只算开火 / 弹药 / 位移（resolveCombat:false），命中、伤害、死亡只认快照与 CombatEventBatch",
        "公共展示（KDA、阵亡复活、保护期）读权威镜像 BattleContext.AuthorityState，不读预测态",
        "本地预测只服务手感：跟位与和解衰减在视图层做"
      ]
    },
    {
      "dot": "rose",
      "title": "校验与失败面",
      "items": [
        "checksum 不一致 → SendMismatch + 现场包；连续不一致是两端不同源的强信号",
        "StartGame 先按 CombatConfigDigest 复算 ConfigHash，不等即拒局",
        "快照走 Unreliable、StartGame / 信令走 Reliable；超预算的快照被计数丢弃（SnapshotDropped）"
      ]
    },
    {
      "dot": "amber",
      "title": "抗丢包与平滑",
      "items": [
        "未确认段从最近快照帧 + 1 起、容量 16 帧重复发送",
        "快照 30Hz 抽帧 + 差分 + AOI 裁剪 + 背压分档，按 AOI 半径裁剪远端实体",
        "视图插值用上一份 / 最新一份快照轮转；回滚期帧事件走静默门，避免重放抖动"
      ]
    }
  ]
