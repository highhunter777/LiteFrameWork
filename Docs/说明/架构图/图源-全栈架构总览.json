  "cards": [
    {
      "dot": "cyan",
      "title": "四层单向依赖",
      "items": [
        "装配层 LiteGame.Bootstrap / .App → 产品域 12 个 Modules → 框架四件 Core / Services / Adapters / Hosting → 零引擎 LiteSim·LiteNet·LiteSync",
        "模块只经自持端口消费实现件；Modules/* 引 LiteGame.Adapters.* 由硬边测试打红",
        "18 段注册序 = 初始化序，关闭＝逆序；容器 Seal 后自动发现 ITickable"
      ]
    },
    {
      "dot": "emerald",
      "title": "双端共编与确定性",
      "items": [
        "LiteSim / LiteNet / LiteSync / RoomServer.Runtime 只有一份源码：Unity asmdef 与 dotnet csproj 同时编译",
        "BuildHash 源集摘要写进协议常量；出包门禁复算，两端不一致即拦",
        "禁超越函数 / FMA / float 等值比较，软件 sqrt + IEEE 逐位一致"
      ]
    },
    {
      "dot": "violet",
      "title": "内容与配置",
      "items": [
        "PatchRunner + YooAsset：候选包 → 签名 → 激活事务 → 反回退，内置/离线/联机三态",
        "Luban 一张表源出两端读码与 .bytes，表值可热更、读码面进 BuildHash 闭包",
        "XLua 只承载 UI 页面逻辑，经白名单门面与沙箱，不碰判定与网络底层"
      ]
    },
    {
      "dot": "amber",
      "title": "云侧形态",
      "items": [
        "Windows Server 2025 + 任务计划 LiteGame-Meta / LiteGame-Room（改配置须重启任务）",
        "云主机仅 WireGuard 隧道 10.8.0.1 可入：UDP 17777 房间服、HTTP 5000 Meta、9101 GM",
        "max_rooms=8、worker_count=1；房型 standard / four / eight / sandbox"
      ]
    }
  ]
